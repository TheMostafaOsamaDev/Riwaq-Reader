{
  "name": "riwaq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome lint src scripts",
    "lint:fix": "biome lint --write src scripts",
    "format": "biome format --write src scripts",
    "format:check": "biome format src scripts",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64 && pnpm verify:jni && pnpm verify:signing",
    "android:build:universal": "tauri android build --apk && pnpm verify:jni && pnpm verify:signing",
    "verify:jni": "bash scripts/verify-jni-bridge.sh",
    "verify:signing": "bash scripts/verify-apk-signing.sh",
    "android:build:debug": "tauri android build --apk --debug --target aarch64",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.11.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
